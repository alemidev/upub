#!/bin/bash

echo "building frontend bundle"
cd web
UPUB_BASE_URL="https://fedi.alemi.dev" CARGO_BUILD_JOBS=4 /opt/bin/trunk build --release --public-url 'https://fedi.alemi.dev/web/assets/' --filehash=false
cd ..
echo "building release binary"
cargo build --release --features=web -j 4
echo "stopping service"
systemctl --user stop upub
echo "installing new binary"
cp ./target/release/upub /opt/bin/upub
echo "migrating database"
/opt/bin/upub -c /etc/upub/config.toml migrate
echo "restarting service"
systemctl --user start upub
echo "done"
